  "sombras_vau": {
    "id": "sombras_vau",
    "nome": "Emboscada no Vau",
    "x": 69.5,
    "y": 54.41,
    "fome": 1,
    "sede": 1,
    "dungeons": [
      {
        "file": "sombras_1_vau.json",
        "encadear": false,
        "intro": {
          "slides": [
            {
              "text": "A Estrada do Vau atravessa o bosque a leste de Alva e Luz. Há três luas nenhuma caravana chega do outro lado.",
              "fit": "contain"
            },
            {
              "text": "Na curva do rio, uma carroça tombada. Cordas cortadas. E, entre as árvores, o brilho de olhos pequenos e amarelos.",
              "fit": "contain"
            }
          ],
          "audio": "assets/story/a_song_of_old_stones.mp3"
        },
        "outro": {
          "slides": [
            {
              "text": "— Não era só roubo — diz Tomé, esfregando os pulsos. — Eles levavam a carga para as velhas minas de Pedra-Funda. Falavam de uma garra negra.",
              "fit": "contain"
            }
          ]
        }
      }
    ],
    "espera_retorno": {
      "modo": "fixa",
      "rodadas": 0,
      "dados": ""
    },
