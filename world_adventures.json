  "sombras_minas": {
    "id": "sombras_minas",
    "nome": "Minas de Pedra-Funda",
    "x": 74.5,
    "y": 47.41,
    "fome": 2,
    "sede": 2,
    "dungeons": [
      {
        "file": "sombras_2_minas.json",
        "encadear": false,
        "intro": {
          "slides": [
            {
              "text": "As minas de Pedra-Funda foram abandonadas quando a veia de prata secou. Agora, dizem os mineiros, a montanha voltou a ranger à noite.",
              "fit": "contain"
            },
            {
              "text": "Pegadas miúdas e rastros de carga arrastada descem para o escuro.",
              "fit": "contain"
            }
          ],
          "audio": "assets/story/a_song_of_old_stones.mp3"
        },
        "outro": {
          "slides": [
            {
              "text": "No cofre, frascos que os kobolds nunca entenderam — ácido e óleo — e um bilhete com o sinal de uma garra negra: o Covil, e um guardião que não morre.",
              "fit": "contain"
            }
          ]
        }
      }
    ],
    "espera_retorno": {
      "modo": "fixa",
      "rodadas": 0,
      "dados": ""
    },
