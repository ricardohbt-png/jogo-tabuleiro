      "pos": [
        5,
        4
      ],
      "falante": {
        "nome": "Mestre de Armas",
        "emoji": "🛡️"
      },
      "texto": "Na bolsa a espada não serve de nada. Abra o inventário e equipe-a: equipar é ação livre, não custa o seu turno.",
      "trigger": {
        "tipo": "proximidade",
        "raio": 3
      },
      "ordem": 3,
      "tarefa": {
        "tipo": "equipar",
